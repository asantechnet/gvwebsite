<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  RewriteRule ^dashboard(?:/|$) - [E=globalvision_noindex:1]

  # Serve generated localized SEO snapshots without forcing trailing slashes.
  RewriteCond %{DOCUMENT_ROOT}/$1/index.html -f
  RewriteRule ^(.+?)/?$ $1/index.html [L]

  # Serve real files and directories without routing them through React.
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # Send the public root and legacy unprefixed routes to default Dari URLs.
  RewriteRule ^$ dr [R=302,L]
  RewriteCond %{REQUEST_URI} !^/(dr|ps|en)(/|$)
  RewriteCond %{REQUEST_URI} !^/dashboard(/|$)
  RewriteRule ^(.+?)/?$ dr/$1 [R=301,L]

  # Let the client-side router resolve every application URL.
  RewriteRule ^ index.html [L]
</IfModule>

<IfModule mod_headers.c>
  Header always set X-Robots-Tag "noindex, nofollow, noarchive" env=globalvision_noindex
</IfModule>
