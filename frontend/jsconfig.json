{
  "compilerOptions": {
    "baseUrl": ".",
    "paths": {
      "@/*": ["src/*"],
      "@website/*": ["src/website/*"],
      "@cms/*": ["src/cms/*"],
      "@components/*": ["src/website/components/*"],
      "@ui/*": ["src/website/components/ui/*"],
      "@shared/*": ["src/website/components/shared/*"],
      "@sections/*": ["src/website/components/sections/*"],
      "@pages/*": ["src/website/components/pages/*"],
      "@layout/*": ["src/website/components/layout/*"],
      "@services/*": ["src/shared/services/*"]
    }
  },
  "exclude": ["dist", "node_modules"]
}
