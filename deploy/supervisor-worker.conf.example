[program:globalvision-worker]
process_name=%(program_name)s_%(process_num)02d
command=php /var/www/globalvision/backend/artisan queue:work --sleep=3 --tries=3 --max-time=3600
directory=/var/www/globalvision/backend
autostart=true
autorestart=true
stopasgroup=true
killasgroup=true
user=www-data
numprocs=2
redirect_stderr=true
stdout_logfile=/var/log/globalvision-worker.log
stopwaitsecs=3700
