server {
    listen 443 ssl http2;
    server_name globalvision.af www.globalvision.af;

    root /var/www/globalvision/frontend/dist;
    index index.html;

    client_max_body_size 52M;

    location /assets/ {
        try_files $uri =404;
        expires 1y;
        add_header Cache-Control "public, immutable";
    }

    location /storage/ {
        alias /var/www/globalvision/backend/storage/app/public/;
        try_files $uri =404;
    }

    location / {
        try_files $uri $uri/ @laravel;
    }

    location @laravel {
        include fastcgi_params;
        fastcgi_param SCRIPT_FILENAME /var/www/globalvision/backend/public/index.php;
        fastcgi_param SCRIPT_NAME /index.php;
        fastcgi_pass unix:/run/php/php-fpm.sock;
    }

    location ~ /\. {
        deny all;
    }
}
